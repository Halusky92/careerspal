API_KEY=your_gemini_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe — use sk_test_ locally. Webhook POST https://your-domain/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email — verify careerspal.com (or send.careerspal-email.com) in Resend, then set From
RESEND_API_KEY=your_resend_api_key
RESEND_FROM="CareersPal <no-reply@careerspal.com>"
ADMIN_NOTIFICATION_EMAIL=info@careerspal.com

# App URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Daily sourcing cron (Vercel + GitHub). Query ?secret= must match.
SOURCING_CRON_SECRET=replace_with_random_string

# Guest job alerts. GitHub Action .github/workflows/careerspal-alerts-daily.yml calls
# GET $CAREERSPAL_ALERTS_URL?secret=$CAREERSPAL_ALERTS_CRON_SECRET (same value as below).
ALERTS_CRON_SECRET=replace_with_random_string

# Founding employer launch (set to 0 to require checkout)
FOUNDING_LAUNCH=1

# Public legal/operator identity (shown on /privacy and /terms)
NEXT_PUBLIC_OPERATOR_NAME="Mgr. Marek Bilek"
NEXT_PUBLIC_OPERATOR_COMPANY_ID=
NEXT_PUBLIC_OPERATOR_VAT_ID=
NEXT_PUBLIC_OPERATOR_ADDRESS=
